# Copy to Dokploy environment variables for the staging application.
# Use branch: staging and docker-compose.staging.yml as compose file.

SECRET_KEY=change-me-staging-secret-key
DEBUG=false
APP_ENV=staging
ALLOWED_HOSTS=staging.macardy.2asoft.tech
APP_DOMAIN=staging.macardy.2asoft.tech

# Target database (staging). Name MUST contain "staging".
DB_HOST=central-postgres
DB_PORT=5432
DB_NAME=macardyapp_staging
DB_USER=mcduser
DB_PASSWORD=mcduser

# Source database for optional refresh (production read-only clone).
DB_SOURCE_NAME=macardyapp
PRODUCTION_DB_NAME=macardyapp
PG_MAINTENANCE_DB=postgres

# Set to true only when you want to clone prod -> staging on deploy.
# macardyapp_staging must already exist in Postgres (mcduser has no CREATEDB).
# One-time in pgAdmin: CREATE DATABASE macardyapp_staging OWNER mcduser;
REFRESH_STAGING_DB=false

# Avoid sending real emails from staging.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Reuse or isolate media storage as needed.
USE_S3_MEDIA=true
AWS_STORAGE_BUCKET_NAME=your-bucket
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
PERSISTENT_MEDIA_BASE_URL=
